# Dependencies
node_modules/
.pnpm-store/

# Bun build output
dist/
*.local

# Build caches
*.tsbuildinfo

# React Cosmos fixture map — regenerated by `pnpm cosmos` on every start.
# Committing it would put a machine-written file in the path of every branch
# that adds a fixture, for no gain: it is derived entirely from what's on disk.
cosmos/cosmos.imports.ts

# VitePress docs cache (build output under docs/.vitepress/dist/ is covered by dist/ above)
docs/.vitepress/cache/

# Test & coverage
coverage/
.nyc_output/

# Env & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python bytecode + caches + venv (xray-py SDK)
__pycache__/
.venv/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Logs
*.log
pnpm-debug.log*

# SQLite transient WAL files next to committed snapshot DB, plus the
# `VACUUM INTO` staging copy the seeder renames over xray.db — only left behind
# by a run that died mid-way.
snapshot/*.db-shm
snapshot/*.db-wal
snapshot/*.db.tmp*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Claude Code subagent worktrees — git worktrees the Agent tool spins up
# under `isolation: "worktree"`. Real working trees with their own checkouts;
# they shouldn't pollute git status here OR trip biome's config discovery
# (their full biome.json copy makes biome see two competing root configs).
.claude/worktrees/
