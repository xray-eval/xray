{
	"name": "xray",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.10.1",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=12.0.0"
	},
	"scripts": {
		"preinstall": "node -e \"if(!(process.env.npm_execpath||'').includes('pnpm')&&!(process.env.npm_config_user_agent||'').startsWith('pnpm/'))throw new Error('Use pnpm — see .claude/rules/supply-chain.md')\"",
		"prepare": "lefthook install",
		"check": "biome check",
		"check:fix": "biome check --write",
		"format": "biome format --write",
		"lint": "biome lint",
		"typecheck": "tsc --noEmit",
		"typecheck:cosmos": "tsc -p cosmos --noEmit",
		"cosmos": "bun cosmos/dev.ts",
		"dev": "UID=$(id -u) GID=$(id -g) docker compose -f compose.dev.yaml up --build",
		"dev:down": "docker compose -f compose.dev.yaml down -v",
		"build": "bun run scripts/build.ts",
		"start": "bun src/server/main.ts",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"docker:build": "docker build -t xray:local .",
		"docker:run": "docker run --rm -p 8080:8080 --env-file .env xray:local",
		"docker:smoke": "bash scripts/docker-smoke.sh",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"seed:snapshot": "bun run scripts/seed-snapshot.ts",
		"test": "bun test --isolate",
		"test:watch": "bun test --isolate --watch",
		"test:coverage": "bun test --isolate --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@happy-dom/global-registrator": "20.14.5",
		"@mswjs/interceptors": "0.45.7",
		"@testing-library/react": "16.3.3",
		"@types/bun": "1.4.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"drizzle-kit": "0.31.11",
		"happy-dom": "20.14.5",
		"lefthook": "2.1.14",
		"mermaid": "12.2.0",
		"msw": "3.0.2",
		"react-cosmos": "7.4.1",
		"react-cosmos-core": "7.4.0",
		"react-cosmos-dom": "7.4.0",
		"typescript": "7.0.2",
		"vitepress": "1.6.4"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@fontsource-variable/onest": "5.3.1",
		"@scalar/hono-api-reference": "0.12.3",
		"@tanstack/react-query": "5.103.2",
		"@tanstack/react-router": "1.170.38",
		"@valibot/to-json-schema": "1.8.0",
		"@wavesurfer/react": "1.0.12",
		"bun-plugin-tailwind": "0.1.2",
		"bunqueue": "2.9.5",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"drizzle-orm": "0.45.3",
		"hono": "4.13.13",
		"hono-openapi": "1.3.3",
		"ky": "2.1.0",
		"lucide-react": "1.47.0",
		"openapi-types": "12.1.3",
		"radix-ui": "1.6.7",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-json-view-lite": "2.5.0",
		"tailwind-merge": "3.7.0",
		"tailwindcss": "4.3.3",
		"ts-pattern": "5.9.0",
		"tw-animate-css": "1.4.0",
		"valibot": "1.5.0",
		"wavesurfer.js": "8.0.1"
	}
}
