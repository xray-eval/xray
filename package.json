{
	"name": "xray",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.1.2",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=11.0.0"
	},
	"scripts": {
		"preinstall": "node -e \"if(!(process.env.npm_execpath||'').includes('pnpm')&&!(process.env.npm_config_user_agent||'').startsWith('pnpm/'))throw new Error('Use pnpm — see .claude/rules/supply-chain.md')\"",
		"prepare": "lefthook install",
		"check": "biome check",
		"check:fix": "biome check --write",
		"format": "biome format --write",
		"lint": "biome lint",
		"typecheck": "tsc --noEmit",
		"typecheck:cosmos": "tsc -p cosmos --noEmit",
		"cosmos": "bun cosmos/dev.ts",
		"dev": "UID=$(id -u) GID=$(id -g) docker compose -f compose.dev.yaml up --build",
		"dev:down": "docker compose -f compose.dev.yaml down -v",
		"build": "bun run scripts/build.ts",
		"start": "bun src/server/main.ts",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"docker:build": "docker build -t xray:local .",
		"docker:run": "docker run --rm -p 8080:8080 --env-file .env xray:local",
		"docker:smoke": "bash scripts/docker-smoke.sh",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"seed:snapshot": "bun run scripts/seed-snapshot.ts",
		"test": "bun test --isolate",
		"test:watch": "bun test --isolate --watch",
		"test:coverage": "bun test --isolate --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@commitlint/cli": "21.2.0",
		"@commitlint/config-conventional": "21.2.0",
		"@happy-dom/global-registrator": "20.10.6",
		"@testing-library/react": "16.3.2",
		"@types/bun": "1.3.14",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"drizzle-kit": "0.31.10",
		"happy-dom": "20.10.6",
		"lefthook": "2.1.9",
		"mermaid": "11.16.0",
		"msw": "2.14.6",
		"react-cosmos": "7.3.0",
		"react-cosmos-core": "7.3.0",
		"react-cosmos-dom": "7.3.0",
		"typescript": "6.0.3",
		"vitepress": "1.6.4",
		"vitepress-plugin-mermaid": "2.0.17"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "5.2.8",
		"@fontsource-variable/onest": "5.2.11",
		"@hono/standard-validator": "0.2.3",
		"@scalar/hono-api-reference": "0.11.8",
		"@tanstack/react-query": "5.101.2",
		"@tanstack/react-router": "1.170.17",
		"@valibot/to-json-schema": "1.7.1",
		"@wavesurfer/react": "1.0.12",
		"bun-plugin-tailwind": "0.1.2",
		"bunqueue": "2.8.26",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"drizzle-orm": "0.45.2",
		"hono": "4.12.30",
		"hono-openapi": "1.3.0",
		"ky": "2.0.2",
		"lucide-react": "1.23.0",
		"openapi-types": "12.1.3",
		"radix-ui": "1.6.1",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-json-view-lite": "2.5.0",
		"tailwind-merge": "3.6.0",
		"tailwindcss": "4.3.2",
		"ts-pattern": "5.9.0",
		"tw-animate-css": "1.4.0",
		"valibot": "1.4.2",
		"wavesurfer.js": "7.12.8"
	}
}
