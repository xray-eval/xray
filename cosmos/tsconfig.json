{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["../src/*"]
		}
	},
	"include": ["."],
	// `cosmos.imports.ts` is generated by `pnpm cosmos` and gitignored, and
	// `renderer.tsx` exists only to import it — so both are absent on a fresh
	// clone. Excluding them is what lets `pnpm typecheck:cosmos` run in CI and
	// before anyone has started the workbench; without it the harness itself
	// (dev.ts, serve-renderer.ts, the error classes) is typechecked by nothing,
	// since the root tsconfig deliberately doesn't include this directory.
	"exclude": ["cosmos.imports.ts", "renderer.tsx"]
}
